<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <!-- LEFT SIDEBAR -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#120F1A"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher_round"
            android:layout_marginBottom="20dp"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/nav_home"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_compass"
            android:background="@drawable/bg_nav_active"
            android:padding="7dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="Home"/>

        <ImageView
            android:id="@+id/nav_profile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:padding="7dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="Profile"/>

        <ImageView
            android:id="@+id/nav_mods"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_manage"
            android:padding="7dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="Mods"/>

        <ImageView
            android:id="@+id/nav_settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:padding="7dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="Settings"/>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/nav_more"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_more"
            android:padding="7dp"
            android:contentDescription="More"/>
    </LinearLayout>

    <!-- MAIN CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- TOP BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RemomLauncher"
                    android:textColor="#F8F8FC"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_premium_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Premium Profile"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"/>
            </LinearLayout>

            <!-- HERO CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#1A1724"
                app:cardElevation="6dp"
                android:layout_marginBottom="14dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#2A1F3D"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tv_version_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Minecraft 1.20.1"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_version_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Latest Release • Ready to launch"
                            android:textColor="#C4C4CC"
                            android:textSize="12sp"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="14dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_launch"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:text="LAUNCH"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:backgroundTint="#22C55E"
                            app:cornerRadius="12dp"
                            android:paddingHorizontal="26dp"/>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- PROFILE + NEWS ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- PROFILE CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="120dp"
                    android:layout_height="150dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="#1A1724"
                    app:cardElevation="4dp"
                    android:layout_marginEnd="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/iv_profile_skin"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@mipmap/ic_launcher_round"
                            android:background="@drawable/bg_skin_circle"
                            android:contentDescription="@null"/>

                        <TextView
                            android:id="@+id/tv_profile_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Player"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/tv_profile_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your Profile"
                            android:textColor="#A1A1AA"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- NEWS CARDS HORIZONTAL -->
                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_premium"
                            android:layout_width="130dp"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="#221F2E"
                            android:layout_marginEnd="8dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="10dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PREMIUM"
                                    android:textColor="#8B5CF6"
                                    android:textSize="10sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:text="Get Premium Access"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:gravity="center_vertical"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_launcher"
                            android:layout_width="130dp"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="#221F2E"
                            android:layout_marginEnd="8dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="10dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="LAUNCHER"
                                    android:textColor="#22C55E"
                                    android:textSize="10sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:text="Launcher Release Announcement"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:gravity="center_vertical"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_update"
                            android:layout_width="130dp"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="#221F2E"
                            android:layout_marginEnd="8dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="10dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NEW UPDATE"
                                    android:textColor="#F97316"
                                    android:textSize="10sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:text="New Custom Content Mod"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:gravity="center_vertical"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/card_mods"
                            android:layout_width="130dp"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="#221F2E">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="10dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MODS"
                                    android:textColor="#A1A1AA"
                                    android:textSize="10sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:text="Browse Mods"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:gravity="center_vertical"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
